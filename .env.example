# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI Payroll"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app
ASSET_URL=

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Database (Railway MySQL plugin)
# On Railway, reference the MySQL service variables, e.g.:
#   DB_HOST=${{MySQL.MYSQLHOST}}
#   DB_PORT=${{MySQL.MYSQLPORT}}
#   DB_DATABASE=${{MySQL.MYSQLDATABASE}}
#   DB_USERNAME=${{MySQL.MYSQLUSER}}
#   DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payroll
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_FOREIGN_KEYS=true

# ---------------------------------------------------------------------------
# Cache / Session / Queue
# ---------------------------------------------------------------------------
CACHE_DRIVER=file
CACHE_PREFIX=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local
FILESYSTEM_CLOUD=s3
MEDIA_DISK=public

# Redis (only if you attach a Redis plugin)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_QUEUE=default

# Memcached (unused by default)
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=

# ---------------------------------------------------------------------------
# Security / hashing
# ---------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Mail (PHPMailer / SMTP). Set MAIL_DRIVER=smtp and fill the rest to send
# invoices & payroll notifications.
# ---------------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
SES_KEY=
SES_SECRET=
SES_REGION=us-east-1
SPARKPOST_SECRET=

# ---------------------------------------------------------------------------
# Stripe (invoice payments). Used directly via env() in InvoiceController.
# ---------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# ---------------------------------------------------------------------------
# AWS S3 (only if FILESYSTEM_DRIVER=s3)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# ---------------------------------------------------------------------------
# Pusher (only if BROADCAST_DRIVER=pusher)
# ---------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ---------------------------------------------------------------------------
# Media / ffmpeg (spatie medialibrary conversions; optional)
# ---------------------------------------------------------------------------
IMAGE_DRIVER=gd
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ---------------------------------------------------------------------------
# OpenAI - powers the AI features (chat assistant, insights, anomaly
# detection, predictive payroll, org-health analysis, OCR document extraction)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
